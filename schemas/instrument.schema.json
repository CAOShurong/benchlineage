{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caoshurong.github.io/benchlineage/schemas/instrument.schema.json",
  "title": "BenchLineage instrument",
  "type": "object",
  "required": ["schema", "id", "kind", "manufacturer", "model", "serial", "created_at"],
  "properties": {
    "schema": {"const": "benchlineage/instrument/v1"},
    "id": {"$ref": "#/$defs/id"},
    "kind": {"type": "string", "minLength": 1},
    "manufacturer": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "serial": {"type": "string", "minLength": 1},
    "asset_tag": {"type": "string"},
    "notes": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
  "additionalProperties": true
}
