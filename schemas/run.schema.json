{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caoshurong.github.io/benchlineage/schemas/run.schema.json",
  "title": "BenchLineage run",
  "type": "object",
  "required": [
    "schema", "id", "study_id", "operator", "started_at", "instruments",
    "raw_files", "conditions", "deviations", "recorded_at"
  ],
  "properties": {
    "schema": {"const": "benchlineage/run/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "study_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "operator": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "instruments": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "raw_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "conditions": {"type": "object"},
    "deviations": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
